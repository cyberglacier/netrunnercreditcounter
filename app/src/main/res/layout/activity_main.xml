<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootlayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:keepScreenOn="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <View
            android:id="@+id/runnerSide"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/black" />

        <View
            android:id="@+id/corpSide"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/black" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/blacklayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/toplayout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="50dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- FrameLayout hält das Layout stabil -->
            <Button
                android:id="@+id/plustop"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="30dp"
                android:layout_marginEnd="0dp"
                android:background="@android:color/transparent"
                android:backgroundTint="@android:color/transparent"
                android:elevation="0dp"
                android:fontFamily="@font/orbitron_medium"
                android:stateListAnimator="@null"
                android:text="+"
                android:textColor="@color/white"
                android:textSize="96sp" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                tools:ignore="NestedWeights">

                <TextView
                    android:id="@+id/creditstop"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:autoSizeTextType="uniform"
                    android:fontFamily="@font/orbitron_medium"
                    android:gravity="center"
                    android:maxLines="1"
                    android:rotation="180"
                    android:text="5"
                    android:textColor="@color/white"
                    android:textSize="90sp" />

                <TextView
                    android:id="@+id/changetop"
                    android:layout_width="wrap_content"
                    android:layout_height="23dp"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="30dp"
                    android:fontFamily="@font/orbitron_medium"
                    android:rotation="180"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:visibility="invisible"
                    tools:text="+2"
                    tools:visibility="visible" />
            </FrameLayout>

            <Button
                android:id="@+id/minustop"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="0dp"
                android:layout_marginEnd="30dp"
                android:background="@android:color/transparent"
                android:backgroundTint="@android:color/transparent"
                android:elevation="0dp"
                android:fontFamily="@font/orbitron_medium"
                android:stateListAnimator="@null"
                android:text="-"
                android:textColor="@color/white"
                android:textSize="96sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/middlelayout"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:gravity="center">

            <ImageView
                android:id="@+id/icon"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:layout_weight="1"
                android:src="@drawable/credit"
                android:tint="@color/white" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/bottomlayout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginBottom="50dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/minusbottom"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="30dp"
                android:background="@android:color/transparent"
                android:backgroundTint="@android:color/transparent"
                android:fontFamily="@font/orbitron_medium"
                android:shadowColor="@color/white"
                android:stateListAnimator="@null"
                android:text="-"
                android:textColor="@color/white"
                android:textSize="96sp" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                tools:ignore="NestedWeights">

                <TextView
                    android:id="@+id/creditsbottom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:autoSizeTextType="uniform"
                    android:fontFamily="@font/orbitron_medium"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="5"
                    android:textColor="@color/white"
                    android:textSize="90sp" />

                <TextView
                    android:id="@+id/changebottom"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="30dp"
                    android:fontFamily="@font/orbitron_medium"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:visibility="invisible"
                    tools:text="+3"
                    tools:visibility="visible" />
            </FrameLayout>

            <Button
                android:id="@+id/plusbottom"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="30dp"
                android:background="@android:color/transparent"
                android:backgroundTint="@android:color/transparent"
                android:fontFamily="@font/orbitron_medium"
                android:shadowColor="@color/white"
                android:stateListAnimator="@null"
                android:text="+"
                android:textColor="@color/white"
                android:textSize="96sp" />
        </LinearLayout>

    </LinearLayout>

    <!-- Runner Color Overlay -->
    <LinearLayout
        android:id="@+id/runnerColorOverlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|top"
        android:alpha="0"
        android:background="#DD000000"
        android:clickable="true"
        android:elevation="10dp"
        android:focusable="true"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:fontFamily="@font/orbitron_medium"
            android:rotation="180"
            android:text="Runner      Faction"
            android:textColor="@color/white"
            android:textSize="20sp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:scrollbars="none"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/iconAnarch"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_margin="10dp"
                    android:rotation="180"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/nsg_anarch" />

                <ImageView
                    android:id="@+id/iconCriminal"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_margin="10dp"
                    android:rotation="180"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/nsg_criminal" />

                <ImageView
                    android:id="@+id/iconShaper"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_margin="10dp"
                    android:rotation="180"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/nsg_shaper" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>


    <!-- Corp Color Overlay (Unten) -->
<LinearLayout
android:id="@+id/corpColorOverlay"
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:layout_gravity="bottom"
android:background="#DD000000"
android:orientation="vertical"
android:padding="20dp"
android:visibility="gone"
android:alpha="0"
android:elevation="10dp"
android:clickable="true"
android:focusable="true">

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iconHB"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_margin="10dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/nsg_hb_reduz" />

            <ImageView
                android:id="@+id/iconJinteki"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_margin="10dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/nsg_jinteki" />

            <ImageView
                android:id="@+id/iconNBN"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_margin="10dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/nsg_nbn" />

            <ImageView
                android:id="@+id/iconWeyland"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_margin="10dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/nsg_weyland" />
        </LinearLayout>
    </HorizontalScrollView>

    <TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="center_horizontal"
    android:fontFamily="@font/orbitron_medium"
    android:text="Corp     Faction"
    android:textColor="@color/white"
    android:textSize="20sp" />

</LinearLayout>

    <!-- Settings Overlay (Mitte) -->
<LinearLayout
android:id="@+id/settingsOverlay"
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:layout_gravity="center"
android:background="#EE000000"
android:orientation="vertical"
android:padding="24dp"
android:visibility="gone"
android:alpha="0"
android:elevation="15dp"
android:clickable="true"
android:focusable="true">

<Button
    android:id="@+id/btnReset"
    android:layout_width="200dp"
    android:layout_height="wrap_content"
    android:fontFamily="@font/orbitron_medium"
    android:text="Reset to 5"
    android:textColor="@color/white"
    android:backgroundTint="@color/black" />

<Button
    android:id="@+id/btnToggleTheme"
    android:layout_width="200dp"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp"
    android:fontFamily="@font/orbitron_medium"
    android:text="Icon/Text Color"
    android:textColor="@color/white"
    android:backgroundTint="@color/black" />

<Button
    android:id="@+id/btnBack"
    android:layout_width="200dp"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp"
    android:fontFamily="@font/orbitron_medium"
    android:text="Back"
    android:textColor="@color/white"
    android:backgroundTint="#333333" />
</LinearLayout>

</FrameLayout>